rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper: is the user authenticated at all?
    function isAuthenticated() {
      return request.auth != null;
    }

    // NOTE: This project stores user documents with the email as the document ID,
    // NOT the Firebase Auth UID. The getUserData() pattern that uses request.auth.uid
    // does NOT work here. We use open authenticated reads instead.

    // ─── Users ───────────────────────────────────────────────────────────────
    // All authenticated users can read user records (needed for dashboard lookups).
    // Only authenticated users can write their own record or any record (admins).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Schools ─────────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Live Bus Locations (nested under schools) ────────────────────────────
    match /schools/{schoolId}/buses/{busId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Buses (flat collection) ──────────────────────────────────────────────
    match /buses/{busId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Trips ───────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      allow read, write: if isAuthenticated();
    }

    // ─── SOS Alerts ──────────────────────────────────────────────────────────
    match /sos_alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Alert Configs ───────────────────────────────────────────────────────
    match /alert_configs/{configId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Subscription Plans ──────────────────────────────────────────────────
    match /subscription_plans/{planId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Subscriptions ───────────────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Routes ──────────────────────────────────────────────────────────────
    match /routes/{routeId} {
      allow read, write: if isAuthenticated();
    }
  }
}
